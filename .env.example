# Grok2API environment variables.
# Copy this file to .env and edit the values. Do NOT commit the real .env.

# ============================================================
# Backend  (server.py)
# ============================================================

# Admin panel password. CHANGE THIS before deploying — the default inside
# server.py is "123" and the app prints a warning while it stays default.
GROK2_ADMIN_PASS=change-me

# ============================================================
# Admin UI  (admin-ui / Next.js)
# ============================================================

# URL the Next.js server proxies /admin/api/* and /v1/* to (see admin-ui/next.config.ts).
# In production keep the Python backend bound to localhost and point this at it.
# Under docker-compose use the service name instead: http://backend:8168
BACKEND_URL=http://localhost:8168

# ------------------------------------------------------------
# Note: .admin_secret (HMAC key that signs admin session cookies) is auto-generated
# by server.py on first run. It is NOT an env var. Keep the file stable across
# restarts so existing admin sessions stay valid, and never commit it.
# ------------------------------------------------------------
